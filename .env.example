# Copy to .env and edit for your environment:
#   cp .env.example .env

# Timezone (e.g. Australia/Sydney, America/New_York)
TZ=Australia/Sydney

# How many raw files (ARW/FITS) to keep on the Pi before pruning oldest.
# ARW ~24MB, so 200 = ~5GB. Adjust for your SD card size.
SHOTS_KEEP=200

# MQTT topic prefix (default is fine unless you run multiple rigs)
MQTT_PREFIX=astrophoto
